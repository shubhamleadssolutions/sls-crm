# ==============================================================================
# Shubham Leads Solutions (SLS) CRM - Production Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (Supabase / Neon / AWS RDS / Self-hosted)
# For Supabase direct IPv6 or Pooler IPv4 connection:
# e.g.: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# JWT Secret for Session Encryption (Generate with: openssl rand -base64 32)
JWT_SECRET="sls-crm-enterprise-secure-jwt-secret-key-2026-production"

# Public Application Domain URL
# e.g.: https://crm.shubhamleadssolutions.com or https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
