generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CEO
  BD_INTERN
  SALES
  MARKETING
  IT_ADMIN
  ACCOUNT_MANAGER
}

enum ProspectStatus {
  NEW_PROSPECT
  RESEARCH_COMPLETED
  CONTACTED
  FOLLOW_UP
  REPLIED
  INTERESTED
  MEETING_DISCUSSION
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  NOT_INTERESTED
  NO_RESPONSE
}

enum LeadSource {
  GOOGLE_MAPS
  LINKEDIN
  FACEBOOK
  WEBSITE
  REFERRAL
  WHATSAPP
  EMAIL
  OTHER
}

enum OutreachChannel {
  WHATSAPP
  EMAIL
  LINKEDIN
  FACEBOOK
  PHONE_CALL
  MEETING
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  NOT_REQUIRED
  DRAFT
  SENT
  VIEWED
  NEGOTIATION
  ACCEPTED
  REJECTED
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum StudentLeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  COUNSELLING_SCHEDULED
  COUNSELLING_DONE
  DEMO_SCHEDULED
  DEMO_ATTENDED
  ADMISSION_CONFIRMED
  NOT_INTERESTED
  LOST
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(ADMIN)
  designation  String?     @default("IT Head")
  phone        String?
  isActive     Boolean     @default(true)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedProspects Prospect[]    @relation("AssignedUser")
  activities        Activity[]
  notes             Note[]
  followUps         FollowUp[]
  clients           Client[]      @relation("AccountManager")
  studentLeads      StudentLead[] @relation("AssignedCounsellor")
  meetings          Meeting[]
  invoicesCreated   Invoice[]
  auditLogs         AuditLog[]
  chatMessages      ChatMessage[]
  attendances       Attendance[]

  @@map("users")
}

model Prospect {
  id                 String         @id @default(cuid())
  prospectCode       String         @unique
  companyName        String
  website            String?
  industry           String?
  city               String?
  state              String?
  country            String?        @default("India")
  companyLinkedInUrl String?
  googleMapsUrl      String?

  contactPerson      String?
  designation        String?
  phone              String?
  whatsappNumber     String?
  email              String?
  linkedInProfileUrl String?

  businessType       String?
  servicesOffered    String?
  targetAudience     String?
  targetLocation     String?
  potentialRequirement String?

  leadSource         LeadSource     @default(OTHER)
  status             ProspectStatus @default(NEW_PROSPECT)

  nextFollowUpDate   DateTime?
  followUpType       OutreachChannel?
  followUpNotes      String?
  followUpCount      Int            @default(0)

  assignedUserId     String?
  assignedUser       User?          @relation("AssignedUser", fields: [assignedUserId], references: [id])

  isArchived         Boolean        @default(false)
  archivedAt         DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  activities         Activity[]
  followUps          FollowUp[]
  notes              Note[]
  requirements       Requirement[]
  proposals          Proposal[]
  meetings           Meeting[]
  client             Client?

  @@index([companyName])
  @@index([status])
  @@index([assignedUserId])
  @@index([nextFollowUpDate])
  @@map("prospects")
}

model Activity {
  id         String          @id @default(cuid())
  prospectId String
  prospect   Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  date       DateTime        @default(now())
  channel    OutreachChannel @default(OTHER)
  activity   String
  result     String?
  notes      String?
  userId     String?
  user       User?           @relation(fields: [userId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([prospectId])
  @@map("activities")
}

model FollowUp {
  id            String          @id @default(cuid())
  prospectId    String
  prospect      Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  type          OutreachChannel @default(WHATSAPP)
  notes         String?
  status        FollowUpStatus  @default(PENDING)
  completedAt   DateTime?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([prospectId])
  @@index([scheduledDate])
  @@index([status])
  @@map("follow_ups")
}

model Meeting {
  id          String    @id @default(cuid())
  prospectId  String?
  prospect    Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  title       String
  meetingDate DateTime
  location    String?  @default("SLS Video Connect")
  meetingUrl  String?
  status      String   @default("Scheduled") // Scheduled, Completed, Cancelled
  agenda      String?
  outcome     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([prospectId])
  @@map("meetings")
}

model Note {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  content    String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([prospectId])
  @@map("notes")
}

model Requirement {
  id                     String   @id @default(cuid())
  prospectId             String
  prospect               Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  requiredService        String?
  courseProgram          String?
  targetAudience         String?
  targetLocation         String?
  expectedLeadRequirement String?
  preferredChannel       String?
  monthlyRequirement     String?
  currentMethod          String?
  budgetRange            String?
  timeline               String?
  specialRequirements    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([prospectId])
  @@map("requirements")
}

model Proposal {
  id           String         @id @default(cuid())
  prospectId   String
  prospect     Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  proposalCode String?        @unique
  proposalDate DateTime       @default(now())
  amount       Decimal?       @db.Decimal(12, 2)
  service      String?
  validUntil   DateTime?
  status       ProposalStatus @default(DRAFT)
  notes        String?
  fileUrl      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([prospectId])
  @@map("proposals")
}

model Client {
  id             String    @id @default(cuid())
  clientId       String    @unique
  prospectId     String?   @unique
  prospect       Prospect? @relation(fields: [prospectId], references: [id])
  companyName    String
  contactPerson  String?
  phone          String?
  email          String?
  service        String?
  startDate      DateTime  @default(now())
  contractType   String?   @default("Monthly Retainer")
  retainerAmount Decimal?  @db.Decimal(12, 2)
  paymentStatus  String?   @default("Pending") // Paid, Pending, Overdue
  campaignStatus String?   @default("Active") // Active, Paused, Completed
  managerId      String?
  manager        User?     @relation("AccountManager", fields: [managerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaigns    Campaign[]
  studentLeads StudentLead[]
  invoices     Invoice[]

  @@map("clients")
}

model Campaign {
  id              String         @id @default(cuid())
  campaignCode    String         @unique
  name            String
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetCourse    String?
  platform        String?        @default("Meta Ads")
  budget          Decimal?       @db.Decimal(12, 2)
  targetLeads     Int?           @default(100)
  generatedLeads  Int            @default(0)
  status          CampaignStatus @default(ACTIVE)
  startDate       DateTime       @default(now())
  endDate         DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  studentLeads    StudentLead[]

  @@index([clientId])
  @@map("campaigns")
}

model StudentLead {
  id               String            @id @default(cuid())
  studentCode      String            @unique
  name             String
  phone            String
  email            String?
  courseInterest   String?
  location         String?
  qualification    String?
  leadSource       String?           @default("Meta Ads")
  consentReference String?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id])
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  status           StudentLeadStatus @default(NEW_LEAD)
  counsellorId     String?
  counsellor       User?             @relation("AssignedCounsellor", fields: [counsellorId], references: [id])
  followUpDate     DateTime?
  followUpNotes    String?
  demoStatus       String?           @default("Pending") // Pending, Scheduled, Attended, No Show
  demoDate         DateTime?
  admissionStatus  String?           @default("Pending") // Pending, Enrolled, Cancelled
  feeAmount        Decimal?          @db.Decimal(12, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId])
  @@index([campaignId])
  @@index([status])
  @@map("student_leads")
}

model Template {
  id        String          @id @default(cuid())
  title     String
  channel   OutreachChannel @default(WHATSAPP)
  category  String?
  content   String
  createdAt DateTime        @default(now())

  @@map("templates")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?
  clientCity      String?
  clientState     String?

  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  status          InvoiceStatus  @default(ISSUED)
  paymentMode     String?        @default("Bank Transfer / NEFT")
  paidDate        DateTime?
  
  // JSON array of items: [{ description: string, quantity: number, rate: number, amount: number }]
  items           Json
  
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal?       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2) // Clean net total without GST as requested!
  amountInWords   String?
  
  notes           String?
  terms           String?        @default("1. Payment to be made via NEFT/RTGS/UPI to Shubham Leads Solutions.\n2. Please mention the invoice number in transaction remarks.\n3. Delayed payments beyond the due date are subject to work pause.")
  
  bankName        String?        @default("HDFC Bank")
  accountName     String?        @default("Shubham Leads Solutions")
  accountNumber   String?        @default("50200088992211")
  ifscCode        String?        @default("HDFC0001234")
  branch          String?        @default("FC Road Branch, Pune")
  upiId           String?        @default("shubhamleads@okhdfcbank")

  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model InventoryItem {
  id          String   @id @default(cuid())
  itemCode    String   @unique
  name        String
  category    String   @default("Service") // Retainer, Lead Package, Campaign Setup, Consultation
  unit        String   @default("Per Month") // Per Month, Per 1000 Leads, Per Campaign, Per Session
  rate        Decimal  @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemCode])
  @@index([category])
  @@map("inventory_items")
}

model ChatMessage {
  id         String   @id @default(cuid())
  channel    String   @default("general") // general, leads-outreach, deals-closings, admissions, announcements, or dm_<userId1>_<userId2>
  content    String
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName String
  senderRole String?
  attachments Json?
  reactions   Json?
  createdAt  DateTime @default(now())

  @@index([channel])
  @@index([createdAt])
  @@map("chat_messages")
}

model Attendance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  punchIn      DateTime  @default(now())
  punchOut     DateTime?
  status       String    @default("PRESENT") // PRESENT, LATE, HALF_DAY
  notes        String?
  workingHours Decimal?  @db.Decimal(5, 2)
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, date])
  @@map("attendances")
}
